# Copy to .env (git-ignored) to override the demo defaults. These are demo-only values.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Act 3 (optional): LLM model used by the rca service, and the cap on one explanation (seconds).
# RCA_MODEL=llama3.2:1b
# RCA_LLM_TIMEOUT_SECONDS=90
# How rca answers: auto (default) = ask the LLM, fall back to a pre-recorded answer after the budget;
# live = LLM only; replay = never call the LLM, always show the pre-recorded answer.
# RCA_MODE=auto
# RCA_LIVE_BUDGET_SECONDS=30

# CPUs given to Ollama (lower it if Docker exposes fewer than 4).
OLLAMA_CPUS=4
